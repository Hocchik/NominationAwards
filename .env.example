# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas el ".env" a git (ya está en .gitignore).

# --- Base de datos (Neon) -------------------------------------------------
# Conexión CON pooler (el host contiene "-pooler"). La usa la app en Vercel.
DATABASE_URL="postgresql://USUARIO:CLAVE@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Opcional: conexión DIRECTA (sin "-pooler"). La usa solo el CLI de Prisma
# para migraciones. Si la dejas vacía, se usa DATABASE_URL.
DIRECT_URL=""

# --- Admin ----------------------------------------------------------------
# Contraseña del organizador para entrar a /admin.
ADMIN_PASSWORD="cambia-esto-por-una-clave-larga"

# --- Sesiones -------------------------------------------------------------
# Secreto para firmar las cookies de sesión (mínimo 32 caracteres aleatorios).
# Generar con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="genera-un-secreto-aleatorio-de-al-menos-32-caracteres"
