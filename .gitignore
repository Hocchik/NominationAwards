# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# variables de entorno: NUNCA subir secretos (DATABASE_URL, ADMIN_PASSWORD...)
.env*
# ...excepto la plantilla sin valores reales
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma: cliente generado (se regenera con `npm install` → postinstall)
/src/generated/prisma

# archivo de llaves privadas del notario, por si alguien lo guarda aquí por error
*-llaves-privadas*.json
notario-*.json

# Claude Code: configuración personal (launch.json sí se versiona)
.claude/settings.local.json

# editores / sistema
.vscode/*
!.vscode/extensions.json
.idea
Thumbs.db
