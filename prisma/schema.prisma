// Esquema de NominacionesDP — ver CLAUDE.md, secciones 4 (anonimato) y 6 (modelo).
//
// REGLAS QUE ESTE ARCHIVO DEBE RESPETAR SIEMPRE:
// - Ballot: sin createdAt/updatedAt, sin IP ni user-agent. participantId solo
//   mientras su fase está abierta (el «nombre por fuera del sobre», para poder
//   resetear un voto hecho por otra persona); se borra al cerrar la fase.
// - Participant: sin @updatedAt ni fechas sobre nominar/votar (solo booleanos).
// - Todos los IDs son UUID v4 explícito: uuid(7) y cuid() incrustan la hora
//   de creación dentro del ID, y eso permitiría ordenar papeletas por llegada.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventPhase {
  SETUP
  NOMINATIONS
  NOMINATIONS_CLOSED
  FINALISTS_READY
  VOTING
  VOTING_CLOSED
  CEREMONY
  FINISHED
}

enum CategoryType {
  PRIZE
  HONORARY
}

/// Cómo se lee el título de la categoría.
enum CategoryFraming {
  NORMAL // «El alma de la fiesta»
  PRONE // rótulo «Más propenso/a a» + el final de la frase: «volverse gay»
  QUESTION // una pregunta tal cual: «¿Con quién dejarías a tu hijo/a?»
}

/// Qué se nomina en la categoría.
enum NomineeKind {
  PERSON // alguien de la lista de invitados
  PAIR // dos invitados juntos (shipeo, dúo)
  OPTION // una de las opciones que carga el organizador
  TEXT // texto libre que escribe cada uno (frases, profes); el organizador elige los finalistas
  DIRECT // no se nomina: el organizador pone los finalistas (eventos) y solo se vota
}

enum BallotPhase {
  NOMINATION
  VOTE
}

model Event {
  id                   String     @id @default(uuid(4))
  name                 String
  roomCode             String     @unique
  phase                EventPhase @default(SETUP)
  capacity             Int        @default(40)
  minNominations       Int        @default(3)
  maxNominations       Int        @default(5)
  finalistsPerCategory Int        @default(4)
  maxPrizeCategories   Int        @default(15)
  nominationPublicKey  String?
  votePublicKey        String?
  notarySetupTokenHash String?
  nominationsCloseAt   DateTime? // a esa hora las nominaciones cierran solas
  votingOpensAt        DateTime?
  votingClosesAt       DateTime?
  showWinnerPercent    Boolean    @default(false)
  allowNominationSkip  Boolean    @default(true) // se puede dejar una categoría sin nominar
  allowVoteAbstention  Boolean    @default(true) // se puede abstener en una categoría al votar

  participants Participant[]
  categories   Category[]
  ballots      Ballot[]
  groupPhotos  GroupPhoto[]
}

// Un nombre de la lista de invitados: lo agrega el admin y la persona lo toca
// en la sala para entrar (sin PIN).
model Participant {
  id             String   @id @default(uuid(4))
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id])
  displayName    String
  normalizedName String // minúsculas y sin tildes, para detectar duplicados
  aliases        String[] @default([]) // apodos («Gabo»): el buscador de la sala también los encuentra
  photoUrl       String? // foto del invitado (JPEG reducido, data URL): se usa en todas las pantallas
  searchNames    String[] @default([]) // otros nombres solo para buscar (segundo nombre, apellidos); nunca se muestran como apodo
  hasNominated   Boolean  @default(false)
  hasVoted       Boolean  @default(false)
  sessionVersion Int      @default(0) // sube al resetear su envío: cierra las sesiones abiertas con ese nombre
  createdAt      DateTime @default(now()) // cuándo se agregó a la lista: permitida
  // SIN @updatedAt (regla de anonimato 3): delataría cuándo nominó o votó.

  @@unique([eventId, normalizedName])
}

model Category {
  id            String          @id @default(uuid(4))
  eventId       String
  event         Event           @relation(fields: [eventId], references: [id])
  name          String
  description   String // la consigna
  type          CategoryType
  sortOrder     Int             @default(0) // orden en que se muestran al nominar
  revealOrder   Int             @default(0) // orden en la ceremonia (se define en la Fase 5)
  activeForVote Boolean         @default(false)
  revealed      Boolean         @default(false)
  framing       CategoryFraming @default(NORMAL)
  nomineeKind   NomineeKind     @default(PERSON)
  maxPicks      Int             @default(1) // cuántos nombres (o parejas u opciones) pone cada persona al nominar
  minPicks      Int             @default(0) // mínimo obligatorio (0 = se puede dejar vacía)
  finalistCount Int             @default(4) // cuántos pasan a la votación (3, 4 o 5); siempre gana uno
  allowExternal Boolean         @default(false) // permite «Otro (fuera del grupo)» al nominar

  finalists Finalist[]
  options   CategoryOption[]

  @@index([eventId, sortOrder])
}

model Finalist {
  id                   String   @id @default(uuid(4))
  categoryId           String
  category             Category @relation(fields: [categoryId], references: [id])
  displayName          String
  participantId        String? // si es del grupo; null si es referente externo
  partnerParticipantId String? // la otra mitad, si la categoría es de parejas
  optionId             String? // si es una opción del organizador (profe, evento, frase)
  photoUrl             String?
  blurb                String?

  @@index([categoryId])
}

/// Opciones que el organizador carga para nominar (profes, eventos, frases).
model CategoryOption {
  id         String   @id @default(uuid(4))
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  label      String // «Ing. Ramírez», «El viaje a Paracas», la frase
  photoUrl   String?
  blurb      String? // detalle corto: quién dijo la frase, el curso del profe…
  sortOrder  Int      @default(0)

  @@index([categoryId])
}

model Ballot {
  id            String      @id @default(uuid(4))
  eventId       String
  event         Event       @relation(fields: [eventId], references: [id])
  phase         BallotPhase
  ciphertext    String // base64 de crypto_box_seal (papeleta con padding fijo)
  // «Nombre por fuera del sobre» (regla de anonimato 2): quién la envió, SOLO
  // mientras la fase está abierta, para que el admin pueda botar el sobre de
  // una persona si votó otra en su nombre. Se borra (null) en la misma
  // transacción que cierra la fase, antes de que el notario abra la urna.
  participantId String?
  // SIN createdAt/updatedAt, SIN IP (regla de anonimato 2).
  // Al leer: ordenar por id o barajar, nunca por orden físico (regla 9).

  @@unique([eventId, phase, participantId])
  @@index([eventId, phase])
}

// Fotos grupales de la entrada de Nominados (hasta 3 por evento). Recuerdos del
// grupo que sube el organizador; no tienen nada que ver con nominaciones ni votos.
model GroupPhoto {
  id       String @id @default(uuid(4))
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id])
  slot     Int // 0, 1 o 2: orden en que pasan como diapositivas
  photoUrl String // JPEG reducido en el navegador, como data URL
  caption  String @default("") // pie de foto: «Año nuevo · 2026»

  @@unique([eventId, slot])
}
