// Esquema de NominacionesDP — ver CLAUDE.md, secciones 4 (anonimato) y 6 (modelo).
//
// REGLAS QUE ESTE ARCHIVO DEBE RESPETAR SIEMPRE:
// - Ballot: sin createdAt/updatedAt, sin IP ni user-agent. participantId solo
//   mientras su fase está abierta (el «nombre por fuera del sobre», para poder
//   resetear un voto hecho por otra persona); se borra al cerrar la fase.
// - Participant: sin @updatedAt ni fechas sobre nominar/votar (solo booleanos).
// - Todos los IDs son UUID v4 explícito: uuid(7) y cuid() incrustan la hora
//   de creación dentro del ID, y eso permitiría ordenar papeletas por llegada.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventPhase {
  SETUP
  NOMINATIONS
  NOMINATIONS_CLOSED
  FINALISTS_READY
  VOTING
  VOTING_CLOSED
  CEREMONY
  FINISHED
}

enum CategoryType {
  PRIZE
  HONORARY
}

enum BallotPhase {
  NOMINATION
  VOTE
}

model Event {
  id                   String     @id @default(uuid(4))
  name                 String
  roomCode             String     @unique
  phase                EventPhase @default(SETUP)
  capacity             Int        @default(40)
  minNominations       Int        @default(3)
  maxNominations       Int        @default(5)
  finalistsPerCategory Int        @default(4)
  maxPrizeCategories   Int        @default(15)
  nominationPublicKey  String?
  votePublicKey        String?
  notarySetupTokenHash String?
  nominationsCloseAt   DateTime? // a esa hora las nominaciones cierran solas
  votingOpensAt        DateTime?
  votingClosesAt       DateTime?
  showWinnerPercent    Boolean    @default(false)
  allowNominationSkip  Boolean    @default(true) // se puede dejar una categoría sin nominar
  allowVoteAbstention  Boolean    @default(true) // se puede abstener en una categoría al votar

  participants Participant[]
  categories   Category[]
  ballots      Ballot[]
}

// Un nombre de la lista de invitados: lo agrega el admin y la persona lo toca
// en la sala para entrar (sin PIN).
model Participant {
  id             String   @id @default(uuid(4))
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id])
  displayName    String
  normalizedName String // minúsculas y sin tildes, para detectar duplicados
  hasNominated   Boolean  @default(false)
  hasVoted       Boolean  @default(false)
  sessionVersion Int      @default(0) // sube al resetear su envío: cierra las sesiones abiertas con ese nombre
  createdAt      DateTime @default(now()) // cuándo se agregó a la lista: permitida
  // SIN @updatedAt (regla de anonimato 3): delataría cuándo nominó o votó.

  @@unique([eventId, normalizedName])
}

model Category {
  id            String       @id @default(uuid(4))
  eventId       String
  event         Event        @relation(fields: [eventId], references: [id])
  name          String
  description   String // la consigna
  type          CategoryType
  sortOrder     Int          @default(0) // orden en que se muestran al nominar
  revealOrder   Int          @default(0) // orden en la ceremonia (se define en la Fase 5)
  activeForVote Boolean      @default(false)
  revealed      Boolean      @default(false)

  finalists Finalist[]

  @@index([eventId, sortOrder])
}

model Finalist {
  id            String   @id @default(uuid(4))
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  displayName   String
  participantId String? // si es del grupo; null si es referente externo
  photoUrl      String?
  blurb         String?

  @@index([categoryId])
}

model Ballot {
  id            String      @id @default(uuid(4))
  eventId       String
  event         Event       @relation(fields: [eventId], references: [id])
  phase         BallotPhase
  ciphertext    String // base64 de crypto_box_seal (papeleta con padding fijo)
  // «Nombre por fuera del sobre» (regla de anonimato 2): quién la envió, SOLO
  // mientras la fase está abierta, para que el admin pueda botar el sobre de
  // una persona si votó otra en su nombre. Se borra (null) en la misma
  // transacción que cierra la fase, antes de que el notario abra la urna.
  participantId String?
  // SIN createdAt/updatedAt, SIN IP (regla de anonimato 2).
  // Al leer: ordenar por id o barajar, nunca por orden físico (regla 9).

  @@unique([eventId, phase, participantId])
  @@index([eventId, phase])
}
